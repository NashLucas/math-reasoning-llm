{
  "output_dir": "checkpoints/sft",
  "num_train_epochs": 3,
  "per_device_train_batch_size": 4,
  "gradient_accumulation_steps": 8,
  "learning_rate": 1e-4,
  "weight_decay": 0.01,
  "warmup_ratio": 0.03,
  "lr_scheduler_type": "cosine",
  "bf16": true,
  "fp16": false,
  "gradient_checkpointing": true,
  "max_seq_length": 512,
  "logging_strategy": "steps",
  "logging_steps": 10,
  "save_strategy": "steps",
  "save_steps": 50,
  "save_total_limit": 5,
  "report_to": [
    "tensorboard"
  ],
  "logging_dir": "logs/training/sft",
  "seed": 42,
  "remove_unused_columns": false
}
